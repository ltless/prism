# Required — generate with: openssl rand -base64 48 | tr -d '\n/=+' | head -c 64
AUTH_SECRET=replace-with-random-64-chars

# Must match backend/.env JWT_SECRET — used to verify Go-issued JWTs in Next.js
JWT_SECRET=replace-with-same-secret-as-backend

# Database (PostgreSQL)
# Password must match POSTGRES_PASSWORD when using docker compose
# (scripts/setup.js generates a random one and keeps backend/.env in sync).
# Example: postgresql://prism:<your-postgres-password>@localhost:5432/prism
DATABASE_URL=postgresql://prism:replace-with-postgres-password@localhost:5432/prism

# AI (optional)
# HF_TOKEN=
# SIDECAR_URL=http://localhost:8081   # python sidecar (auto-started by pnpm dev/prod)
# SIDECAR_KEY=                        # shared secret for sidecar auth (unset = dev mode, auth disabled)

# Storage paths (optional)
# STORAGE_PATH=
# MODELS_PATH=
# Concurrent post-upload processing (thumbnail + metadata) jobs; default 4
# MEDIA_PROCESSING_CONCURRENCY=4
# Upload requests per minute per IP (POST /api/v1/media); default 100.
# Raise for large imports: UPLOAD_RATE_LIMIT=600
# UPLOAD_RATE_LIMIT=100

# Security
# NUKE_CONFIRMATION_TOKEN=generate-with-openssl-rand-hex-32
# REGISTRATION_INVITE_CODE=
# 32 bytes, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
# Processes fail to start (fail closed) if missing/invalid. Backup this key
# separately from the server — losing it means the media library is unreadable.
# ENCRYPTION_MASTER_KEY=replace-with-openssl-rand-hex-32
# NEXT_ALLOWED_ORIGINS=
# AUTH_TRUST_HOST=true   # set to true only behind a trusted proxy
# COOKIE_SECURE=true     # force Secure on auth + vault cookies when TLS
#                        # terminates at a proxy (Go then sees plain http)

# Backend location (both optional, default http://localhost:8080).
# BACKEND_URL — where the Next.js /api/v1/* rewrite forwards to. Point it at
#   the service name when Next and Go run in separate containers, e.g.
#   http://backend:8080 in docker compose.
# GO_API_URL — the same address, used by server-side goFetch() calls.
# BACKEND_URL=
# GO_API_URL=
