{
  "name": "prism-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently -n fe,be -c cyan,green \"pnpm dev:fe\" \"pnpm dev:be\"",
    "dev:fe": "NODE_OPTIONS=\"--max-old-space-size=4096\" next dev",
    "dev:be": "cd backend && go run ./cmd/server/",
    "dev:win": "next dev",
    "dev:expose": "rm -rf .next && NODE_OPTIONS=\"--max-old-space-size=4096\" next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:be": "cd backend && go build -o prism-server ./cmd/server/",
    "start": "next start",
    "start:be": "cd backend && go run ./cmd/server/",
    "start:all": "concurrently -n fe,be -c cyan,green \"pnpm start\" \"pnpm start:be\"",
    "prod": "npm run build && npm run start:all",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "setup:env": "node scripts/setup-env.js",
    "setup": "node scripts/setup.js",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.42.2",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.2.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
