{
  "name": "prism-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently -n fe,be,ai -c cyan,green,magenta \"next dev\" \"cd backend && go run ./cmd/server/\" \"pnpm dev:ai\"",
    "dev:fe": "NODE_OPTIONS=\"--max-old-space-size=4096\" next dev",
    "dev:be": "cd backend && go run ./cmd/server/",
    "dev:ai": "cd python-sidecar && uv run uvicorn app.main:app --port 8081 --host 127.0.0.1 --reload",
    "dev:win": "next dev",
    "dev:expose": "rm -rf .next && NODE_OPTIONS=\"--max-old-space-size=4096\" next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:be": "cd backend && go build -o prism-server ./cmd/server/",
    "start": "next start",
    "start:be": "cd backend && go run ./cmd/server/",
    "start:ai": "cd python-sidecar && uv run uvicorn app.main:app --port 8081 --host 127.0.0.1",
    "start:all": "concurrently -n fe,be,ai -c cyan,green,magenta \"next start\" \"cd backend && go run ./cmd/server/\" \"pnpm start:ai\"",
    "prod": "npm run build && npm run start:all",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "setup:env": "node scripts/setup-env.js",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.42.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.0.2",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
