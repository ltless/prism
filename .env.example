# Required — generate with: openssl rand -base64 48 | tr -d '\n/=+' | head -c 64
AUTH_SECRET=replace-with-random-64-chars

# Must match backend/.env JWT_SECRET — used to verify Go-issued JWTs in Next.js
JWT_SECRET=replace-with-same-secret-as-backend

# Database (SQLite default)
DATABASE_URL=./prism.db

# AI (optional)
# HF_TOKEN=
# SIDECAR_URL=http://localhost:8081   # python sidecar (auto-started by pnpm dev/prod)
# SIDECAR_KEY=                        # shared secret for sidecar auth (unset = dev mode, auth disabled)

# Storage paths (optional)
# STORAGE_PATH=
# MODELS_PATH=

# Security
# NUKE_CONFIRMATION_TOKEN=generate-with-openssl-rand-hex-32
# REGISTRATION_INVITE_CODE=
# NEXT_ALLOWED_ORIGINS=
# AUTH_TRUST_HOST=true   # set to true only behind a trusted proxy
