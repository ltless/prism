# Build
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG AUTH_SECRET JWT_SECRET BACKEND_URL GO_API_URL
ENV AUTH_SECRET=$AUTH_SECRET JWT_SECRET=$JWT_SECRET \
    BACKEND_URL=$BACKEND_URL GO_API_URL=$GO_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# Runtime — production frontend. Note: `next start` is not yet validated
# end-to-end (MediaLibrary hydration regression tracked separately), so this
# image pins the same next-config that dev uses.
FROM node:22-alpine AS run
RUN corepack enable
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build /src/.next ./.next
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/package.json ./package.json
COPY --from=build /src/next.config.ts ./next.config.ts
COPY --from=build /src/public ./public
EXPOSE 3000
CMD ["pnpm", "start", "-p", "3000"]